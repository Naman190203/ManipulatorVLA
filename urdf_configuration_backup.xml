<?xml version="1.0"?>
<robot name="custom_5dof_manipulator">

  <!-- ================= MATERIALS (Distinct Colors) ================= -->
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.8 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.9 0.9 0.1 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="magenta">
    <color rgba="0.9 0.1 0.9 1.0"/>
  </material>

  <!-- ================= WORLD LINK ================= -->
  <link name="world"/>

  <!-- ================= BASE LINK (Flat on Ground Plane) ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.04"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
  </joint>

  <!-- ================= LINK 1 ================= -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.043"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.043"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- ================= LINK 2 ================= -->
  <link name="link_2">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.043" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- ================= LINK 3 ================= -->
  <link name="link_3">
    <visual>
      <origin xyz="0.03875 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0775 0.035 0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.03875 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0775 0.035 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- ================= LINK 4 (Link 3') ================= -->
  <link name="link_4">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.0775 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- ================= LINK 5 (Final Revolute DOF 5) ================= -->
  <link name="link_5">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- ================= GRIPPER BASE ================= -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="magenta"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_5"/>
    <child link="gripper_base"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
  </joint>
  <link name="left_finger">
    <visual>
      <origin xyz="0 0.01 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.015 0.02"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.01 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.015 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.03 0.01 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- RIGHT GEAR / FINGER LINK                   -->
  <!-- ========================================== -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 -0.01 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.015 0.02"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.01 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.015 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.03 -0.01 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- ACTIVE REVOLUTE JOINT (Left Gear Pivot)    -->
  <!-- ========================================== -->
  <joint name="left_gear_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0.01 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Rotates around Z axis -->
    <limit lower="-0.5" upper="0.0" effort="50.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ========================================== -->
  <!-- MIMIC REVOLUTE JOINT (Right Gear Pivot)    -->
  <!-- ========================================== -->
  <joint name="right_gear_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0.01 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Rotates around Z axis in opposite direction -->
    <limit lower="0.0" upper="0.5" effort="50.0" velocity="1.0"/>
    <mimic joint="left_gear_joint" multiplier="-1.0" offset="0.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

</robot>
 